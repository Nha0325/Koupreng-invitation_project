#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
# Koupreng Installation & Development Quick Reference
# ─────────────────────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════════════════════
# FRONTEND-USER SETUP (React + Vite)
# ═════════════════════════════════════════════════════════════════════════════

# Create new Vite project (only for initial setup)
npm create vite@latest frontend-user -- --template react

# Navigate and install dependencies
cd frontend-user
npm install

# Install required packages
npm install react-router-dom zustand framer-motion react-icons lenis
npm install tailwindcss @tailwindcss/vite
npm install axios
npm install eslint  # Note: 'lint' is not a package, use 'eslint'

# Start development server
npm run dev
# → http://localhost:5173

cd ..

# ═════════════════════════════════════════════════════════════════════════════
# BACKEND SETUP (Spring Boot + Java)
# ═════════════════════════════════════════════════════════════════════════════

# Navigate to backend directory
cd ~/Desktop/Koupreng-invitation_project/backend

# Make Maven wrapper executable (first time only)
chmod +x mvnw

# Compile without tests (faster)
./mvnw -DskipTests compile

# Run Spring Boot backend
./mvnw spring-boot:run
# → http://localhost:8080

# Clean and rebuild (when needed)
./mvnw clean spring-boot:run

cd ..

# ═════════════════════════════════════════════════════════════════════════════
# TELEGRAM BOT SETUP (Python + FastAPI)
# ═════════════════════════════════════════════════════════════════════════════

# Navigate to telegram-bot directory
cd ~/Desktop/Koupreng-invitation_project/telegram-bot

# Start with uvicorn (FastAPI server)
python -m uvicorn main:app --host 0.0.0.0 --port 8000
# → http://localhost:8000

# Alternative: Start with custom script
python start.py

# Check webhook status (replace with your bot token)
curl -s "https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getWebhookInfo"
# Example:
# curl -s "https://api.telegram.org/bot8973041657:AAFfIZqDI0iFsU4vJ2GMGFQ5pW2KW0B19NY/getWebhookInfo"

# Verify Python syntax (optional)
python3 -m py_compile telegram-bot/main.py telegram-bot/start.py

cd ..

# ═════════════════════════════════════════════════════════════════════════════
# GIT COMMANDS (Version Control)
# ═════════════════════════════════════════════════════════════════════════════

# View recent commits
git log --oneline -10
git log --oneline -15

# View all branches (local and remote)
git branch -a

# Abort rebase (if stuck in rebase)
git rebase --abort

# Check for whitespace errors
git diff --check -- telegram-bot/main.py telegram-bot/start.py

# ───────────────────────────────────────────────────────────────────────────
# Git Push (Enhanced Interactive Script)
# ───────────────────────────────────────────────────────────────────────────

# Interactive mode with menu (30 predefined options)
./git-push.sh

# Direct mode with custom message
./git-push.sh "Your custom message"

# ═════════════════════════════════════════════════════════════════════════════
# ALL-IN-ONE DEVELOPMENT (Recommended)
# ═════════════════════════════════════════════════════════════════════════════

# Start all services at once (backend, frontend-user, frontend-admin, telegram-bot, ngrok)
./dev.sh

# Start without ngrok
./dev.sh --no-ngrok

# Start without telegram bot
./dev.sh --no-bot

# ═════════════════════════════════════════════════════════════════════════════
# QUICK START COMMANDS BY SERVICE
# ═════════════════════════════════════════════════════════════════════════════

# Backend only
cd backend && ./mvnw spring-boot:run

# Frontend-user only
cd frontend-user && npm run dev

# Frontend-admin only
cd frontend-admin && npm run dev

# Telegram bot only
cd telegram-bot && python start.py

# ═════════════════════════════════════════════════════════════════════════════
# PROJECT STRUCTURE
# ═════════════════════════════════════════════════════════════════════════════

# Koupreng-invitation_project/
# ├── backend/              → Spring Boot API (port 8080)
# ├── frontend-user/        → User-facing React app (port 5173)
# ├── frontend-admin/       → Admin dashboard React app (port 5174)
# ├── telegram-bot/         → Telegram bot FastAPI (port 8000)
# ├── dev.sh                → Start all services
# ├── git-push.sh           → Interactive git push
# ├── setup.sh              → Initial project setup
# └── install               → This file (quick reference)

# ═════════════════════════════════════════════════════════════════════════════
# COMMON ISSUES & FIXES
# ═════════════════════════════════════════════════════════════════════════════

# Port already in use
# → Stop the process using the port or use dev.sh which handles this automatically

# Backend won't start
# → Check .env file for correct database credentials
# → Ensure MySQL is running
# → Check logs in logs/backend.log

# Telegram bot webhook issues
# → Use ngrok to expose your local server
# → Run: ./dev.sh (includes ngrok tunnel)
# → Check webhook: curl -s "https://api.telegram.org/bot<TOKEN>/getWebhookInfo"

# Git conflicts during rebase
# → Fix conflicts in files
# → Run: git add .
# → Run: git rebase --continue
# → Or abort: git rebase --abort

# ═════════════════════════════════════════════════════════════════════════════
# NOTES
# ═════════════════════════════════════════════════════════════════════════════

# - Always pull before starting work: ./git-pull.sh
# - Use ./dev.sh for local development (starts everything)
# - Never commit .env files or secrets
# - Use ./git-push.sh for safe pushing with menu options
# - Check README.md for detailed setup instructions
