VITE_API_URL=/api
VITE_AUTH_STORAGE=localStorage

# Social auth
# Put real frontend values in frontend-user/.env.local.
# Restart Vite after changing any VITE_* value.
# For local Vite:
#   VITE_PUBLIC_APP_URL=http://localhost:5173
# For ngrok:
#   VITE_PUBLIC_APP_URL=https://your-domain.ngrok-free.dev
#   Current dev tunnel example: https://siren-devoutly-probe.ngrok-free.dev
# Google Cloud Console Authorized JavaScript origins:
#   http://localhost:5173
#   https://your-domain.ngrok-free.dev
#   https://siren-devoutly-probe.ngrok-free.dev
# Telegram BotFather:
#   Run /setdomain and use only the host, without https://
#   your-domain.ngrok-free.dev
#   siren-devoutly-probe.ngrok-free.dev
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_TELEGRAM_CLIENT_ID=
VITE_TELEGRAM_BOT_ID=your_numeric_bot_id
VITE_TELEGRAM_BOT_USERNAME=your_bot_username_without_@
VITE_PUBLIC_APP_URL=http://localhost:5173
