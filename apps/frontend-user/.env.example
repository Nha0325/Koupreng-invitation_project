# ============================================================
# FRONTEND
# ============================================================
# VITE_API_BASE_URL        - Base URL for API calls from frontend
# VITE_API_URL             - API path prefix
# VITE_GOOGLE_CLIENT_ID    - Google OAuth Client ID (from Google Cloud Console)
# VITE_TELEGRAM_BOT_USERNAME - Telegram bot username for login widget
# VITE_TELEGRAM_CLIENT_ID  - Telegram OAuth client ID (numeric)
# ============================================================
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=191138536182-jmrl9t3u51e13frff29g18qvtc8g4kvp.apps.googleusercontent.com
VITE_TELEGRAM_BOT_USERNAME=koupreng_invitation_bot
VITE_TELEGRAM_BOT_ID=8973041657
VITE_TELEGRAM_CLIENT_ID=8973041657
VITE_PUBLIC_APP_URL=https://whisking-oblivion-slimness.ngrok-free.dev

# ============================================================
# DATABASE
# ============================================================
# DB_URL       - JDBC connection string (MySQL)
# DB_USERNAME  - Database username
# DB_PASSWORD  - Database password
# ============================================================
DB_URL=jdbc:mysql://localhost:3306/koupreng_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Phnom_Penh&allowPublicKeyRetrieval=true
DB_USERNAME=star
DB_PASSWORD=Nha0325@

# ============================================================
# JWT / AUTH
# ============================================================
# JWT_SECRET                - Secret key for signing tokens (min 64 chars)
# JWT_ISSUER                - Token issuer name
# JWT_ACCESS_TOKEN_MINUTES  - Access token expiry in minutes
# ============================================================
JWT_SECRET=replace_with_a_random_64_character_or_longer_secret
JWT_ISSUER=koupreng-backend
JWT_ACCESS_TOKEN_MINUTES=60

# ============================================================
# PASSWORD RESET & EMAIL VERIFICATION
# ============================================================
# PASSWORD_RESET_TOKEN_MINUTES              - Reset token expiry
# PASSWORD_RESET_FRONTEND_URL               - Frontend URL for reset page
# PASSWORD_RESET_EMAIL_FROM                 - Sender email for reset
# PASSWORD_RESET_LOG_TOKEN_IN_DEVELOPMENT   - Log token in dev (true/false)
# EMAIL_VERIFICATION_TOKEN_MINUTES          - Verification token expiry
# EMAIL_VERIFICATION_FRONTEND_URL           - Frontend URL for verify page
# EMAIL_VERIFICATION_LOG_TOKEN_IN_DEVELOPMENT - Log token in dev (true/false)
# ============================================================
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
PASSWORD_RESET_EMAIL_FROM=no-reply@koupreng.local
PASSWORD_RESET_LOG_TOKEN_IN_DEVELOPMENT=false
EMAIL_VERIFICATION_TOKEN_MINUTES=1440
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:5173/verify-email
EMAIL_VERIFICATION_LOG_TOKEN_IN_DEVELOPMENT=false

# ============================================================
# GOOGLE OAUTH (Backend)
# ============================================================
# GOOGLE_CLIENT_IDS    - Accepted Google Client IDs (comma-separated)
# GOOGLE_JWK_SET_URI   - Google public keys endpoint for token verification
# ============================================================
GOOGLE_CLIENT_IDS=191138536182-jmrl9t3u51e13frff29g18qvtc8g4kvp.apps.googleusercontent.com
GOOGLE_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs

# ============================================================
# TELEGRAM OAUTH (Backend)
# ============================================================
# TELEGRAM_BOT_TOKEN             - Bot token from @BotFather
# TELEGRAM_AUTH_MAX_AGE_SECONDS  - Max age for auth data validation
# TELEGRAM_EMAIL_DOMAIN          - Fake email domain for Telegram users
# TELEGRAM_BOT_USERNAME          - Bot username
# TELEGRAM_CLIENT_ID             - Telegram OAuth client ID
# TELEGRAM_JWK_SET_URI           - Telegram public keys endpoint
# ============================================================
TELEGRAM_BOT_TOKEN=8973041657:AAFfIZqDI0iFsU4vJ2GMGFQ5pW2KW0B19NY
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_EMAIL_DOMAIN=telegram.local
TELEGRAM_BOT_USERNAME=koupreng_invitation_bot
TELEGRAM_CLIENT_ID=8973041657
TELEGRAM_JWK_SET_URI=https://oauth.telegram.org/.well-known/jwks.json

# ============================================================
# MISC
# ============================================================
# FIRST_USER_ADMIN_ENABLED   - First registered user becomes admin
# FLYWAY_BASELINE_ON_MIGRATE - Baseline DB on first migration
# BACKEND_BASE_URL           - Backend base URL
# ============================================================
FIRST_USER_ADMIN_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=true
BACKEND_BASE_URL=http://localhost:8080

# ============================================================
# CORS
# ============================================================
# CORS_ENABLED          - Enable/disable CORS
# CORS_ALLOWED_ORIGINS  - Allowed frontend origins (comma-separated)
# CORS_ALLOWED_METHODS  - Allowed HTTP methods
# CORS_ALLOWED_HEADERS  - Allowed request headers
# CORS_EXPOSED_HEADERS  - Headers exposed to browser
# CORS_MAX_AGE_SECONDS  - Preflight cache duration
# ============================================================
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://whisking-oblivion-slimness.ngrok-free.dev
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,X-Request-Id
CORS_EXPOSED_HEADERS=X-Request-Id
CORS_MAX_AGE_SECONDS=1800

# ============================================================
# HTTPS / HSTS
# ============================================================
# HTTPS_REQUIRED           - Require HTTPS (false for local dev)
# HSTS_ENABLED             - Enable HTTP Strict Transport Security
# HSTS_MAX_AGE_SECONDS     - HSTS max age
# ============================================================
HTTPS_REQUIRED=false
HSTS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000

# ============================================================
# API LOGGING
# ============================================================
# API_LOGGING_ENABLED               - Enable request logging
# API_LOGGING_INCLUDE_QUERY_STRING   - Log query params
# API_LOGGING_INCLUDE_HEALTH_CHECKS  - Log health check requests
# ============================================================
API_LOGGING_ENABLED=true
API_LOGGING_INCLUDE_QUERY_STRING=false
API_LOGGING_INCLUDE_HEALTH_CHECKS=false

# ============================================================
# FILE UPLOAD
# ============================================================
# UPLOAD_MAX_FILE_SIZE         - Max single file size (human-readable)
# UPLOAD_MAX_REQUEST_SIZE      - Max total request size
# UPLOAD_VALIDATION_ENABLED    - Enable file validation
# UPLOAD_MAX_FILE_SIZE_BYTES   - Max file size in bytes
# UPLOAD_MAX_FILES             - Max files per request
# UPLOAD_ALLOWED_CONTENT_TYPES - Allowed MIME types
# UPLOAD_ALLOWED_EXTENSIONS    - Allowed file extensions
# UPLOAD_VERIFY_SIGNATURES     - Verify file magic bytes
# ============================================================
UPLOAD_MAX_FILE_SIZE=5MB
UPLOAD_MAX_REQUEST_SIZE=25MB
UPLOAD_VALIDATION_ENABLED=true
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_MAX_FILES=5
UPLOAD_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,application/pdf
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.pdf
UPLOAD_VERIFY_SIGNATURES=true
CLIENT_ADDRESS_FORWARDED_HEADERS_ENABLED=false

# ============================================================
# RATE LIMITING
# ============================================================
# RATE_LIMIT_BACKEND          - Backend type: memory | redis
# RATE_LIMIT_REDIS_KEY_PREFIX - Redis key prefix (if using redis)
# RATE_LIMIT_FAIL_CLOSED      - Block requests if rate limiter fails
# ============================================================
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_KEY_PREFIX=koupreng:rate-limit:
RATE_LIMIT_FAIL_CLOSED=true

# ============================================================
# WAF (Web Application Firewall)
# ============================================================
# WAF_ENABLED                    - Enable WAF
# WAF_AUDIT_ONLY                 - Log only, don't block (for testing)
# WAF_PROTECTED_PATH_PREFIXES    - Paths to protect
# WAF_ALLOWED_METHODS            - Allowed HTTP methods
# WAF_MAX_URI_LENGTH             - Max URI length
# WAF_MAX_QUERY_LENGTH           - Max query string length
# WAF_MAX_BODY_BYTES             - Max request body size
# WAF_MAX_HEADER_VALUE_LENGTH    - Max single header value length
# WAF_MAX_HEADER_COUNT           - Max number of headers
# WAF_MAX_REQUESTS_PER_MINUTE    - Rate limit per IP per minute
# ============================================================
WAF_ENABLED=true
WAF_AUDIT_ONLY=false
WAF_PROTECTED_PATH_PREFIXES=/api
WAF_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
WAF_MAX_URI_LENGTH=2048
WAF_MAX_QUERY_LENGTH=2048
WAF_MAX_BODY_BYTES=65536
WAF_MAX_HEADER_VALUE_LENGTH=4096
WAF_MAX_HEADER_COUNT=80
WAF_MAX_REQUESTS_PER_MINUTE=120

# ============================================================
# EMAIL (SMTP)
# ============================================================
# SPRING_MAIL_HOST       - SMTP server host
# SPRING_MAIL_PORT       - SMTP server port
# SPRING_MAIL_USERNAME   - SMTP username
# SPRING_MAIL_PASSWORD   - SMTP password
# ============================================================
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=change_me
SPRING_MAIL_PASSWORD=change_me
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ============================================================
# JWT COOKIE AUTH
# ============================================================
AUTH_COOKIE_ENABLED=false
AUTH_COOKIE_NAME=koupreng_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_HTTP_ONLY=true
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_MAX_AGE_SECONDS=900
CORS_ALLOW_CREDENTIALS=false
VITE_AUTH_STORAGE=localStorage

